{
  "instructions": [
    ".opencode/instructions/overview.md",
    ".opencode/instructions/conventions.md",
    ".opencode/instructions/architecture.md",
    ".opencode/instructions/code-map.md"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "model": "lms/qwen2.5-3b-instruct",
  "provider": {
    "lms": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:1235/v1",
        "apiKey": "no-key-needed"
      },
      "models": {
        "qwen2.5-3b-instruct": {
          "limit": {
            "context": 131072,
            "output": 4096
          },
          "tools": {
            "edit": false,
            "write": true,
            "execute": true,
            "shell": true,
            "read": true,
            "grep": true,
            "glob": true,
            "skill": true,
            "todowrite": true,
            "question": true,
            "webfetch": true,
            "websearch": true,
            "bash": true,
            "lsp": true
          }
        }
      }
    }
  },
  "default_agent": "developer",
  "agent": {
    "developer": {
      "model": "lms/qwen2.5-3b-instruct",
      "description": "Unified senior full-stack developer managing architectural planning, minimalist code implementation, modifications, and testing inside an 8GB VRAM hardware window."
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "ask",
    "lsp": "ask"
  }
}
