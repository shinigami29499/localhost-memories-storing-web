{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/overview.md",
    ".opencode/instructions/conventions.md",
    ".opencode/instructions/architecture.md",
    ".opencode/instructions/code-map.md"
  ],
  "compaction": {
    "auto": false
  },
  "model": "lms/qwen/qwen3.5-9b",
  "providers": {
    "lms": {
      "name": "LMS (Local Model Server)",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:1235/v1",
        "timeout": false
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5:9B",
          "modelID": "qwen/qwen3.5-9b",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "default_agent": "developer",
  "agents": {
    "developer": {
      "model": "lms/qwen/qwen3.5-9b",
      "description": "Unified senior full-stack developer managing architectural planning, minimalist code implementation, modifications, and testing inside an 8GB VRAM hardware window."
    }
  },
  "permissions": [
    { "action": "tool.use", "resource": "read", "effect": "allow" },
    { "action": "tool.use", "resource": "edit", "effect": "allow" },
    { "action": "tool.use", "resource": "grep", "effect": "allow" },
    { "action": "tool.use", "resource": "glob", "effect": "allow" },
    { "action": "tool.use", "resource": "skill", "effect": "allow" },
    { "action": "tool.use", "resource": "todowrite", "effect": "allow" },
    { "action": "tool.use", "resource": "question", "effect": "allow" },
    { "action": "tool.use", "resource": "webfetch", "effect": "allow" },
    { "action": "tool.use", "resource": "websearch", "effect": "allow" },
    { "action": "tool.use", "resource": "bash", "effect": "ask" },
    { "action": "tool.use", "resource": "lsp", "effect": "ask" }
  ]
}
