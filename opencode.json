{
  "instructions": [
    ".opencode/instructions/overview.md",
    ".opencode/instructions/conventions.md",
    ".opencode/instructions/architecture.md",
    ".opencode/instructions/code-map.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "model": "qwen2.5-coder:7b-instruct",
  "providers": {
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Ollama (Local)",
      "settings": {
        "baseURL": "http://127.0.0.1:11434",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b-instruct": {
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "tools": {
            "edit": true,
            "write": true
          }
        }
      }
    }
  },
  "default_agent": "developer",
  "agent": {
    "developer": {
      "model": "ollama/qwen2.5-coder:7b-instruct",
      "description": "Unified senior full-stack developer managing brainstorming, architectural planning, minimalist implementation, and testing inside an 8GB VRAM hardware window."
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "write",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
